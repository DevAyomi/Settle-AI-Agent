# Settle Agent Environment Variables
PORT=3000
HOST=0.0.0.0

# Solana Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
# USDC mint used for settlement. Two supported options on devnet:
#   1. Circle devnet USDC (below) - fund the merchant wallet at https://faucet.circle.com
#   2. An app-managed test mint - run `npm run devnet:mint` and paste the address here,
#      then `npm run devnet:fund 10000` to mint test USDC into the treasury.
USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Optional PostgreSQL Database (defaults to zero-config local SQLite if omitted)
# DATABASE_URL=postgresql://user:password@localhost:5432/settle_agent

# Optional Redis for BullMQ (defaults to in-memory async worker queue if omitted)
# REDIS_URL=redis://127.0.0.1:6379

# Telegram Bot (Optional: Interactive Telegram Simulator is built directly into Dashboard!)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Agent Polling Frequency (ms)
AGENT_POLL_INTERVAL_MS=30000

# USDC to NGN FX Rate
DEFAULT_USDC_NGN_RATE=1520.00
